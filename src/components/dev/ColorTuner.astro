      destructive: ["#dc2626", "#f87171"],
    },
    lavender: {
      background: ["#f5f5fa", "#16161f"],
      foreground: ["#34334d", "#dcdcf0"],
      primary: ["#10b981", "#34d399"],
      "primary-foreground": ["#ffffff", "#052e1f"],
      accent: ["#7c6fd6", "#a99cf2"],
      "accent-foreground": ["#ffffff", "#16161f"],
      muted: ["#ebebf3", "#22222e"],
      "muted-foreground": ["#6e6d85", "#9a99b0"],
      border: ["#e0e0ea", "#2c2c3a"],
      ring: ["#a3a2b8", "#55546b"],
      destructive: ["#dc2626", "#f87171"],
    },
  }

  const STORAGE_KEY = "color-tuner"
  const root = document.documentElement

  function loadOverrides(): Overrides {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "{}")
    } catch {
      return {}
    }
  }

  function saveOverrides(overrides: Overrides) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(overrides))
  }

  /** Resolve a token's original color for one scheme as #rrggbb plus alpha. */
  function resolveDefault(token: string, scheme: Scheme) {
    const probe = document.createElement("div")
    probe.style.setProperty("color-scheme", scheme)
    probe.style.setProperty("color", `var(--${token})`)
    document.body.append(probe)
    const color = getComputedStyle(probe).color
    probe.remove()
    return toHex(color)
  }

  /** Canvas normalises any CSS color format (oklch, color-mix, …) to sRGB hex. */
  function toHex(color: string) {
    const ctx = document.createElement("canvas").getContext("2d")!
    ctx.fillStyle = color
    ctx.fillRect(0, 0, 1, 1)
    const [r, g, b, a] = ctx.getImageData(0, 0, 1, 1).data
    const hex = `#${[r, g, b].map((n) => n.toString(16).padStart(2, "0")).join("")}`
    return { hex, alpha: a / 255 }
  }

  const defaults = new Map<string, { hex: string; alpha: number }>()

  function getDefault(token: string, scheme: Scheme) {
    const key = `${token}:${scheme}`
    if (!defaults.has(key)) {
      // Resolve against the stylesheet value, not our own override.
      const override = root.style.getPropertyValue(`--${token}`)
      root.style.removeProperty(`--${token}`)
      defaults.set(key, resolveDefault(token, scheme))
      if (override) root.style.setProperty(`--${token}`, override)
    }
    return defaults.get(key)!
  }

  /** Keep the original alpha (e.g. a translucent border) when a hex is picked. */
  function withAlpha(hex: string, alpha: number) {
    if (alpha >= 1) return hex
    const [r, g, b] = [1, 3, 5].map((i) =>
      Number.parseInt(hex.slice(i, i + 2), 16),
    )
    return `rgb(${r} ${g} ${b} / ${Math.round(alpha * 100)}%)`
  }

  function tokenValue(token: string, overrides: Overrides) {
    const pick = (scheme: Scheme) => {
      const base = getDefault(token, scheme)
      const override = overrides[token]
      return withAlpha(
        override?.[scheme] ?? base.hex,
        override?.alpha?.[scheme] ?? base.alpha,
      )
    }
    return `light-dark(${pick("light")}, ${pick("dark")})`
  }

  function presetOverrides(name: string): Overrides {
    const preset = PRESETS[name]
    if (!preset) return {}
    return Object.fromEntries(
      Object.entries(preset).map(([token, [lightColor, darkColor]]) => {
        const light = toHex(lightColor)
        const dark = toHex(darkColor)
        return [
          token,
          {
            light: light.hex,
            dark: dark.hex,
            alpha: { light: light.alpha, dark: dark.alpha },
          },
        ]
      }),
    )
  }

  function applyOverrides(overrides: Overrides) {
    for (const token of Object.keys(overrides)) {
      root.style.setProperty(`--${token}`, tokenValue(token, overrides))
    }
  }

  function initTuner() {
    const panel = document.querySelector<HTMLElement>("[data-color-tuner]")
    if (!panel || panel.dataset.ready === "true") return
    panel.dataset.ready = "true"

    const status = panel.querySelector<HTMLElement>("[data-tuner-status]")!
    const inputs = panel.querySelectorAll<HTMLInputElement>("input[data-token]")
    const presetSelect = panel.querySelector<HTMLSelectElement>(
      "[data-tuner-preset]",
    )!
    let overrides = loadOverrides()

    function syncInputs() {
      for (const input of inputs) {
        const token = input.dataset.token!
        const scheme = input.dataset.scheme as Scheme
        input.value =
          overrides[token]?.[scheme] ?? getDefault(token, scheme).hex
      }
    }

    function clearOverrides() {
      for (const token of Object.keys(overrides))
        root.style.removeProperty(`--${token}`)
      overrides = {}
    }

    presetSelect.value =
      localStorage.getItem(`${STORAGE_KEY}-preset`) ?? "default"
    presetSelect.addEventListener("change", () => {
      clearOverrides()
      overrides = presetOverrides(presetSelect.value)
      applyOverrides(overrides)
      saveOverrides(overrides)
      localStorage.setItem(`${STORAGE_KEY}-preset`, presetSelect.value)
      syncInputs()
      status.textContent = `Preset: ${presetSelect.selectedOptions[0].text}`
    })

    syncInputs()
    for (const input of inputs) {
      const token = input.dataset.token!
      const scheme = input.dataset.scheme as Scheme
      input.addEventListener("input", () => {
        overrides[token] = { ...overrides[token], [scheme]: input.value }
        root.style.setProperty(`--${token}`, tokenValue(token, overrides))
        saveOverrides(overrides)
      })
    }

    panel
      .querySelector("[data-tuner-copy]")!
      .addEventListener("click", async () => {
        const tokens = Object.keys(overrides)
        if (tokens.length === 0) {
          status.textContent = "Nothing changed yet."
          return
        }
        const css = tokens
          .map((t) => `  --${t}: ${tokenValue(t, overrides)};`)
          .join("\n")
        await navigator.clipboard.writeText(css)
        status.textContent = `Copied ${tokens.length} token(s).`
      })

    panel.querySelector("[data-tuner-reset]")!.addEventListener("click", () => {
      clearOverrides()
      saveOverrides(overrides)
      presetSelect.value = "default"
      localStorage.setItem(`${STORAGE_KEY}-preset`, "default")
      syncInputs()
      status.textContent = "Reset to color.css."
    })
  }

  applyOverrides(loadOverrides())
  initTuner()
  // ClientRouter replaces <html> attributes on navigation; re-apply overrides.
  document.addEventListener("astro:after-swap", () =>
    applyOverrides(loadOverrides()),
  )
  document.addEventListener("astro:page-load", initTuner)
</script>
