---
/**
 * Dev-only floating panel for tuning the theme's semantic color tokens live.
 * Overrides are applied to :root, kept in localStorage, and exported as CSS
 * ready to paste into src/styles/color.css. Not rendered in production builds.
 */
const TOKENS = [
  "background",
  "foreground",
  "primary",
  "primary-foreground",
  "accent",
  "accent-foreground",
  "muted",
  "muted-foreground",
  "border",
  "ring",
  "destructive",
]
---

<details class="color-tuner" transition:persist="color-tuner" data-color-tuner>
  <summary aria-label="Color tuner">🎨</summary>
  <div class="color-tuner-panel">
    <p class="color-tuner-title">Color tuner <span>(dev only)</span></p>
    <label class="color-tuner-preset">
      Preset
      <select data-tuner-preset>
        <option value="default">Current (color.css)</option>
        <option value="original">Original theme default</option>
        <option value="ocean">Ocean · navy + teal</option>
        <option value="paper">Paper · warm ivory + amber</option>
        <option value="forest">Forest · sage + green</option>
        <option value="mono">Mono · neutral + indigo</option>
        <option value="terminal">Terminal · old-site cyan + violet</option>
        <optgroup label="Round 2 · cool &amp; minimal">
          <option value="slate">Slate · blue-gray + sky</option>
          <option value="ink">Ink · pure neutral + electric blue</option>
          <option value="graphite">Graphite · neutral + teal</option>
          <option value="midnight">Midnight · indigo + teal</option>
          <option value="arctic">Arctic · frost blue + soft violet</option>
          <option value="lavender">Lavender · refined default</option>
        </optgroup>
      </select>
    </label>
    <table>
      <thead>
        <tr>
          <th>Token</th>
          <th>Light</th>
          <th>Dark</th>
        </tr>
      </thead>
      <tbody>
        {TOKENS.map((token) => (
          <tr>
            <td><code>{token}</code></td>
            <td><input type="color" data-token={token} data-scheme="light" aria-label={`${token} light`} /></td>
            <td><input type="color" data-token={token} data-scheme="dark" aria-label={`${token} dark`} /></td>
          </tr>
        ))}
      </tbody>
    </table>
    <div class="color-tuner-actions">
      <button type="button" data-tuner-copy>Copy CSS</button>
      <button type="button" data-tuner-reset>Reset</button>
    </div>
    <p class="color-tuner-status" data-tuner-status aria-live="polite"></p>
  </div>
</details>

<style>
  .color-tuner {
    position: fixed;
    inset-block-end: 1rem;
    inset-inline-start: 1rem;
    z-index: 1000;
    font-size: 0.8rem;
  }

  .color-tuner summary {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--background);
    cursor: pointer;
    list-style: none;
    font-size: 1.2rem;
    box-shadow: 0 2px 8px rgb(0 0 0 / 25%);
  }

  .color-tuner summary::-webkit-details-marker {
    display: none;
  }

  .color-tuner-panel {
    position: absolute;
    inset-block-end: 3rem;
    inset-inline-start: 0;
    max-block-size: 75vh;
    overflow: auto;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--background);
    color: var(--foreground);
    box-shadow: 0 4px 16px rgb(0 0 0 / 30%);
  }

  .color-tuner-title {
    margin: 0 0 0.5rem;
    font-weight: 600;
  }

  .color-tuner-title span,
  .color-tuner-status {
    color: var(--muted-foreground);
    font-weight: 400;
  }

  .color-tuner-preset {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-block-end: 0.5rem;
  }

  .color-tuner select {
    flex: 1;
    padding: 0.2rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    background: var(--background);
    color: var(--foreground);
  }

  .color-tuner table {
    border-collapse: collapse;
  }

  .color-tuner th,
  .color-tuner td {
    padding: 0.15rem 0.4rem;
    text-align: start;
  }

  .color-tuner input[type="color"] {
    inline-size: 2.5rem;
    block-size: 1.6rem;
    padding: 0;
    border: 1px solid var(--border);
    background: none;
    cursor: pointer;
  }

  .color-tuner-actions {
    display: flex;
    gap: 0.5rem;
    margin-block-start: 0.5rem;
  }

  .color-tuner button {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    background: var(--muted);
    color: var(--foreground);
    cursor: pointer;
  }

  .color-tuner-status {
    margin: 0.4rem 0 0;
    min-block-size: 1em;
  }
</style>

<script>
  type Scheme = "light" | "dark"
  type TokenOverride = Partial<Record<Scheme, string>> & {
    /** Explicit alpha per scheme; falls back to the stylesheet's alpha. */
    alpha?: Partial<Record<Scheme, number>>
  }
  type Overrides = Record<string, TokenOverride>

  /** Each token as [light, dark]; every preset sets all tokens, fully opaque. */
  const PRESETS: Record<string, Record<string, [string, string]>> = {
