      primary: ["#3b6ea8", "#7fb2d9"],
      "primary-foreground": ["#ffffff", "#0f1d2b"],
      accent: ["#6a5fb0", "#a99fe0"],
      "accent-foreground": ["#ffffff", "#1b1f27"],
      muted: ["#e8ecf2", "#252a34"],
      "muted-foreground": ["#667085", "#98a2b3"],
