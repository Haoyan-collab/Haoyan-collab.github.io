@inproceedings{shi2026ukast,
  abbr          = {ISBI},
  title         = {U-KAST: Kolmogorov-Arnold Swin Transformer for Medical Image Segmentation},
  author        = {Nishchal Sapkota and Haoyan Shi and Yejia Zhang and Xianshi Ma and Bofang Zheng and Fabian Vazquez and Pengfei Gu and Danny Z. Chen},
  booktitle     = {IEEE International Symposium on Biomedical Imaging},
  year          = {2026},
  eprint        = {2511.04084},
  archivePrefix = {arXiv},
  url           = {https://arxiv.org/abs/2511.04084},
  pdf           = {UKAST.pdf},
  preview       = {UKAST_ABS.png},
  abstract      = {Medical image segmentation is critical for accurate diagnostics and treatment planning, but remains challenging due to complex anatomical structures and limited annotated training data. We introduce UKAST, a U-Net-like architecture that integrates rational-function-based Kolmogorov-Arnold Networks (KANs) into Swin Transformer encoders. By leveraging rational base functions and Group Rational KANs, UKAST improves on the inefficiencies of vanilla spline-based KANs, yielding a more expressive and data-efficient framework with reduced FLOPs and only a very small increase in parameter count compared to SwinUNETR. UKAST achieves state-of-the-art performance on four diverse 2D and 3D medical image segmentation benchmarks, consistently surpassing CNN- and Transformer-based baselines, including in data-scarce settings.},
  selected      = {true}
}

@inproceedings{shi2026dgem,
  abbr        = {MICCAI},
  title       = {D-GEM: Sparsely Supervised Surgical Video Segmentation},
  author      = {Nishchal Sapkota and Yejia Zhang and Bofang Zheng and Xianshi Ma and Haoyan Shi and Yohannes Mariam and Danny Z. Chen},
  booktitle   = {International Conference on Medical Image Computing and Computer-Assisted Intervention},
  year        = {2026},
  pdf         = {MICCAI_2026_DGEM_Camera_Ready.pdf},
  preview     = {DGEM_ABS.png},
  abstract    = {Surgical video segmentation often operates on long image sequences for which dense annotation is prohibitively expensive, making sparse supervision more practical. We propose a reliability-gated asymmetric dual-memory framework built on self-supervised visual representations of DINOv3. Our model accounts for short-term temporal continuity and long-term semantic stability using a gated transient memory with bounded capacity and an evolving anchor memory that incrementally builds semantic representations without requiring complete first-frame class coverage. By decoupling memory from the encoder, the framework enables direct use of pre-trained vision foundation encoders and facilitates data-efficient adaptation under surgical-video domain shift. Experiments on multiple surgical video datasets demonstrate improved temporal consistency and robustness compared to state-of-the-art baselines.},
  selected    = {true}
}
